# =============================================================================
# Environment Variables Template (React/Express/PostgreSQL)
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Node environment: development, test, production
NODE_ENV=development

# Server port
# Development: Use 3000 or higher
# Production: Use 3000 (standard default)
PORT=3000

# Application URL (for CORS, redirects, etc.)
APP_URL=http://localhost:3000

# API URL (if separate from app)
API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with Prisma)
# -----------------------------------------------------------------------------

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_app_dev?schema=public

# Database connection pool size
DATABASE_POOL_SIZE=10

# Enable SSL for database connections (production)
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# JWT secret key (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# Required for production - MUST BE AT LEAST 64 CHARACTERS
JWT_SECRET=

# JWT expiration times
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Session secret (for express-session if used)
SESSION_SECRET=

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Redis Configuration (for BullMQ queues, caching, sessions)
# -----------------------------------------------------------------------------

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (if required)
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------

# SMTP settings for production
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com

# Or use an adapter like Mailgun, SendGrid, etc.
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------

# GitHub (for MCP server integration)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (if using payments)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Interactor (for OAuth, AI Assistants, Workflow, etc)
# INTERACTOR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (if using AI features)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Error Tracking & Monitoring
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0

# LogRocket (alternative/addition to Sentry for frontend)
# LOGROCKET_APP_ID=

# -----------------------------------------------------------------------------
# Cloud Services
# -----------------------------------------------------------------------------

# AWS (for S3, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Cloudinary (for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable experimental features
# FEATURE_NEW_UI=false
# FEATURE_BETA_API=false

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------

# Enable hot reload
# HOT_RELOAD=true

# Show detailed error messages (NEVER in production)
# SHOW_ERROR_DETAILS=true

# Prisma debug logging
# DEBUG=prisma:query

# -----------------------------------------------------------------------------
# React Native / Mobile Specific
# -----------------------------------------------------------------------------

# Expo project slug
# EXPO_PROJECT_SLUG=

# App Store / Play Store
# APPLE_TEAM_ID=
# GOOGLE_SERVICES_JSON=./google-services.json
