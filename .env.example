# =============================================================================
# EaseMuse environment. Copy to .env.local (git-ignored) and fill in the values.
# NEVER commit .env.local. Validated at startup by apps/web/src/lib/env.ts.
# NODE_ENV is managed by Next.js; do not set it here.
# =============================================================================

# --- Application -------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
# web | worker (sizes the database pool, names connections)
# PROCESS_ROLE=web

# --- Database (PostgreSQL 16 + pgvector) -------------------------------------
# Create the local databases and the runtime role first: pnpm db:setup
#
# DATABASE_URL: the RUNTIME role easemuse_app (not the table owner, no BYPASSRLS).
#   The app refuses to start if this role could bypass row-level security (ADR-001).
DATABASE_URL=postgresql://easemuse_app:easemuse_app@localhost:5432/easemuse_dev
# DATABASE_ADMIN_URL: the OWNER role, used only by Prisma migrations (pnpm db:migrate).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/easemuse_dev
# DATABASE_URL_DATARIGHTS: the DATA-RIGHTS role easemuse_datarights, the only login that may change audit rows.
#   Set it on the worker only; the candidate anonymization job refuses to run without it (ADR-016).
# DATABASE_URL_DATARIGHTS=postgresql://easemuse_datarights:easemuse_datarights@localhost:5432/easemuse_dev
# Defaults: 10 (web), 20 (worker)
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=true
# Local-development escape hatch only (ignored in production): boot with a privileged DB role.
# ALLOW_PRIVILEGED_DB_ROLE=true

# --- Tests -------------------------------------------------------------------
# Database tests only run against a database named *_test (created by pnpm db:setup).
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/easemuse_test
# TEST_DATABASE_URL=postgresql://easemuse_app:easemuse_app@localhost:5432/easemuse_test
# Fail instead of skipping when the test database is unreachable (set in CI).
# REQUIRE_DB=1

# --- PDF rendering (worker) ---------------------------------------------------
# The worker prints documents with headless Chromium (default: the one Playwright installed;
# run `pnpm exec playwright install chromium` once). It reaches the web app at RENDER_BASE_URL.
# CHROMIUM_PATH=/usr/bin/chromium
# RENDER_BASE_URL=http://localhost:3000
# Without S3_* below, generated PDFs are kept in the database (development only).

# --- Redis (BullMQ queues, SSE fan-out) --------------------------------------
REDIS_URL=redis://localhost:6379

# --- Interactor services (sign-in via Auth.js, service tokens) ---------------
# Base URLs default to production hosts (lib/interactor/service-urls.ts).
# ACCOUNT_SERVER_URL=https://auth.interactor.com
# Billing Server: off (default) | fake (in-memory, one process, for trying the screens) | live (needs the client below).
# See docs/planning/billing.md for what to provide.
# BILLING_MODE=off
# BILLING_SERVER_URL=https://billing.interactor.com
# INTERACTOR_CORE_URL=http://localhost:4002
# INTERACTOR_USERDB_URL=https://userdb.interactor.com
# UKB_URL=http://localhost:4005
# The app's Account Server client (provided by the product owner; never commit):
# INTERACTOR_AUTH_CLIENT_ID=
# INTERACTOR_AUTH_CLIENT_SECRET=
# generate with: openssl rand -base64 32
# AUTH_SECRET=
# Second factor for agency users and platform admins: off | log (default) | enforce.
# Needs the Account Server to emit amr/acr claims (risk TR-011); stay on `log` until verified.
# MFA_ENFORCEMENT=log

# --- AI ----------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# --- Object storage for generated files (S3-compatible) ----------------------
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email (without SMTP the dev-capture transport is used) ------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
