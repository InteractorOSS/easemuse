{
  "name": "@easemuse/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --cache --cache-strategy content --cache-location node_modules/.cache/eslint/web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker": "PROCESS_ROLE=worker tsx src/worker/index.ts",
    "worker:dev": "PROCESS_ROLE=worker tsx watch src/worker/index.ts",
    "predev": "pnpm --filter @easemuse/tokens run build",
    "prebuild": "pnpm --filter @easemuse/tokens run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@easemuse/core": "workspace:*",
    "@easemuse/tokens": "workspace:*",
    "@next/env": "16.3.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "bullmq": "^5.81.5",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
